{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rex-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "rex-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--env-file",
        ".env",
        "uvicorn",
        "rex_api.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "rex-agent",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--env-file",
        ".env",
        "python",
        "-m",
        "rex_agent",
        "dev"
      ],
      "port": 8081
    }
  ]
}