# Copy to .env and fill in. Never commit .env.
# Core
DATABASE_URL=postgresql+asyncpg://rex:rex@localhost:5432/rex
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=          # >= 32 random chars
DEV_AUTH=0               # 1 = local dev only: anonymous dev user + magic-link token in response
TOKEN_ENC_KEY=            # 32-byte base64, for AES-GCM token encryption

# Voice
GNANI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLMs
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# Tools
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
SLACK_BOT_TOKEN=
NOTION_TOKEN=
NOTION_MINUTES_TEMPLATE_ID=
GITHUB_TOKEN=
VEXA_URL=
VEXA_API_KEY=
BRAVE_API_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
